---
---

<section id="contact" style="background: var(--grijs);">
  <div style="max-width:1200px;margin:0 auto;">
    <div class="section-eyebrow">Direct contact</div>
    <h2 class="section-title">Neem contact op</h2>
    <div class="contact-grid">

      <div class="contact-info">
        <p style="color:#aaa;font-size:17px;line-height:1.7;margin-bottom:8px;">
          Heeft u een vraag of wilt u een vrijblijvende offerte? Wij nemen zo snel mogelijk contact met u op.
        </p>

        <div class="contact-item">
          <div class="contact-icon"><svg viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg></div>
          <div><div class="contact-item-label">Telefoon</div><div class="contact-item-value">06 50 48 55 99</div></div>
        </div>

        <div class="contact-item">
          <div class="contact-icon"><svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg></div>
          <div><div class="contact-item-label">E-mail</div><div class="contact-item-value">info@bruggink-techniek.nl</div></div>
        </div>

        <div class="contact-item">
          <div class="contact-icon"><svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg></div>
          <div><div class="contact-item-label">Werkgebied</div><div class="contact-item-value">Overijssel &amp; omgeving</div></div>
        </div>

        <div class="contact-item">
          <div class="contact-icon"><svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg></div>
          <div><div class="contact-item-label">Adres</div><div class="contact-item-value">Weidehuisstraat 14<br/>7771 WD Hardenberg</div></div>
        </div>

        <a href="https://www.google.com/maps/dir/?api=1&destination=Weidehuisstraat+14,+7771+WD+Hardenberg" target="_blank" rel="noopener noreferrer" class="kaart-link">
          <div class="kaart-container">
            <iframe src="https://maps.google.com/maps?q=Weidehuisstraat+14,+7771+WD+Hardenberg&t=&z=15&ie=UTF8&iwloc=&output=embed" width="100%" height="200" style="border:0;border-radius:4px;pointer-events:none;" allowfullscreen="" loading="lazy"></iframe>
            <div class="kaart-overlay">Klik voor routebeschrijving</div>
          </div>
        </a>

        <!-- Keurmerken -->
        <div class="keurmerken">
          <img src="/erkend_leerbedrijf.png" alt="Erkend leerbedrijf" />
          <img src="/co-vrij-logo.png" alt="CO Vrij - Koolmonoxide vrij" />
        </div>

      </div>

      <form class="contact-form">
        <div class="form-row">
          <input type="text" placeholder="Voornaam" />
          <input type="text" placeholder="Achternaam" />
        </div>
        <input type="email" placeholder="E-mailadres" />
        <input type="tel" placeholder="Telefoonnummer" />
        <textarea placeholder="Uw bericht of vraag..."></textarea>
        <button type="submit" class="btn-primary" style="align-self:flex-start;border:none;cursor:pointer;">Verstuur bericht</button>
      </form>
    </div>
  </div>
</section>
