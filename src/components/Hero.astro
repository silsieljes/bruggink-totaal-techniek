---
import logo from '../assets/logo.jpeg';
import team from '../assets/team.jpeg';
---
<div class="hero">
  <div class="hero-bg" style={`background-image: url(${team.src})`}></div>
  <div class="hero-overlay"></div>
  <div class="hero-accent"></div>
  <div class="hero-logo">
    <img src={logo.src} alt="Bruggink Totaal Techniek" />
  </div>
  <div class="hero-content">
    <div class="hero-eyebrow">Bruggink Totaal Techniek</div>
    <h1 class="hero-title">
      Uw specialist<br>in <span>totaal</span><br>techniek
    </h1>
    <p class="hero-sub">Van elektra en zonnepanelen tot warmtepompen en badkamerrenovatie — wij zorgen voor de complete installatie.</p>
    <div class="hero-btns">
      <a href="#contact" class="btn-primary">Vrijblijvende offerte</a>
      <a href="#diensten" class="btn-outline">Bekijk onze diensten</a>
    </div>
  </div>
</div>
