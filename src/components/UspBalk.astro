---
const usps = [
  'Vakkundig & betrouwbaar',
  'Gecertificeerd installateur',
  'Snel & flexibel',
  'Regio Drenthe, Overijssel & omgeving',
];
---
<div class="usp-balk">
  {usps.map(usp => (
    <div class="usp-item">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      {usp}
    </div>
  ))}
</div>
