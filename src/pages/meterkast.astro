---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Meterkast installatie en uitbreiding door Bruggink Totaal Techniek — veilig, modern en toekomstbestendig in Drenthe en Overijssel." />
    <title>Meterkast — Bruggink Totaal Techniek</title>
  </head>
  <body>
    <Nav />

    <div class="mk-hero">
      <div class="mk-hero-bg" style="background-image: url('/meterkast/meterkast2.jpeg')"></div>
      <div class="mk-hero-overlay"></div>
      <div class="mk-hero-content">
        <div class="hero-eyebrow">Elektra</div>
        <h1 class="hero-title">Meter<span>kast</span></h1>
        <p class="hero-sub">De meterkast is het hart van uw elektra-installatie. Bruggink Totaal Techniek plaatst, vervangt en breidt meterkasten uit — veilig, overzichtelijk en klaar voor de toekomst.</p>
        <a href="/#contact" class="btn-primary">Vraag een offerte aan</a>
      </div>
    </div>

    <div class="usp-balk">
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Gecertificeerd installateur
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Nieuwbouw & renovatie
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Hager groepenverdelers
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Klaar voor laadpaal & zonnepanelen
      </div>
    </div>

    <section style="background: var(--zwart);">
      <div style="max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;">
        <div>
          <div class="section-eyebrow">Meterkast installatie</div>
          <h2 class="section-title">Veilig, overzichtelijk<br>& toekomstklaar</h2>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Een verouderde of te kleine meterkast is niet alleen onhandig — het kan ook gevaarlijk zijn. Moderne apparaten zoals warmtepompen, laadpalen en zonnepanelen vragen om een installatie die daarvoor is uitgerust. Bruggink Totaal Techniek vervangt uw oude groepenkast door een moderne, veilige verdeler die aan alle eisen voldoet.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Wij werken met kwaliteitsmerken zoals Hager — overzichtelijke, betrouwbare groepenverdelers die netjes gelabeld en keuringswaardig worden opgeleverd. Of het nu gaat om een enkelvoudige woning, een nieuwbouwproject of een appartementencomplex — wij hebben de kennis en ervaring voor elk type installatie.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;">
            Naast vervanging verzorgen wij ook uitbreidingen van bestaande meterkasten, bijvoorbeeld voor een extra groep voor een laadpaal, zonnepanelen of een aanbouw. Wij denken met u mee over de slimste oplossing voor uw situatie.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:20px;">
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Veilige installatie</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Met aardlekschakelaars en moderne beveiliging</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Klaar voor de toekomst</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Geschikt voor laadpaal, warmtepomp & zonnepanelen</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><rect x="2" y="3" width="20" height="18" rx="2"/><line x1="8" y1="3" x2="8" y2="21"/><circle cx="14" cy="9" r="2"/><circle cx="14" cy="15" r="2"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Netjes & overzichtelijk</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Gelabeld, gekeurd en keuringswaardig opgeleverd</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Snelle uitvoering</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Vervanging veelal binnen één dag gereed</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--grijs);padding-top:80px;padding-bottom:80px;">
      <div style="max-width:1200px;margin:0 auto;">
        <div class="section-eyebrow">Onze projecten</div>
        <h2 class="section-title">Eerder uitgevoerde<br>installaties</h2>
        <div class="zp-galerij">
          <div class="zp-foto zp-foto-groot">
            <img src="/meterkast/meterkast2.jpeg" alt="Dubbele Hager groepenverdeler installatie" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/meterkast/meterkast1.jpeg" alt="Meterkast nieuwbouw schuur" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/meterkast/meterkast3.jpeg" alt="Meterkast met zonnepanelen en PV aansluiting" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--zwart);text-align:center;padding:80px 60px;">
      <div class="section-eyebrow" style="justify-content:center;">Aan de slag</div>
      <h2 class="section-title">Meterkast vervangen of uitbreiden?</h2>
      <p style="color:#aaa;font-size:18px;max-width:600px;margin:0 auto 40px;line-height:1.7;">
        Vraag vrijblijvend een offerte aan. Wij komen langs voor advies en installeren uw nieuwe meterkast snel en vakkundig.
      </p>
      <a href="/#contact" class="btn-primary">Vrijblijvende offerte aanvragen</a>
    </section>

    <Footer />
  </body>
</html>

<style>
  .mk-hero {
    position: relative;
    height: 70vh;
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    margin-top: 90px;
  }
  .mk-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    filter: brightness(0.4);
  }
  .mk-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14,14,14,1) 0%, rgba(14,14,14,0.4) 60%, transparent 100%);
  }
  .mk-hero-content {
    position: relative;
    z-index: 2;
    padding: 0 60px 70px;
    max-width: 700px;
  }
  .zp-galerij {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .zp-foto-groot { grid-column: span 2; }
  .zp-foto img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }
  .zp-foto-groot img { height: 400px; }
  .zp-foto { overflow: hidden; }
  .zp-foto:hover img { transform: scale(1.04); }
  @media (max-width: 768px) {
    .mk-hero-content { padding: 0 24px 50px; }
    .zp-galerij { grid-template-columns: 1fr; }
    .zp-foto-groot { grid-column: span 1; }
    .zp-foto img, .zp-foto-groot img { height: 220px; }
  }
</style>
