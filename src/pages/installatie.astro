---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Complete elektra installatie door Bruggink Totaal Techniek — van bedrading tot meterkast in Drenthe en Overijssel." />
    <title>Complete Elektra — Bruggink Totaal Techniek</title>
  </head>
  <body>
    <Nav />

    <div class="el-hero">
      <div class="el-hero-bg" style="background-image: url('/zonnepanelen/zonnepanelen3.jpeg')"></div>
      <div class="el-hero-overlay"></div>
      <div class="el-hero-content">
        <div class="hero-eyebrow">Elektra</div>
        <h1 class="hero-title">Complete <span>elektra</span></h1>
        <p class="hero-sub">Van nieuwe bedrading tot een complete elektra-installatie — Bruggink Totaal Techniek regelt het vakkundig, veilig en netjes afgewerkt voor woningen en bedrijfspanden.</p>
        <a href="/#contact" class="btn-primary">Vraag een offerte aan</a>
      </div>
    </div>

    <div class="usp-balk">
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Gecertificeerd installateur
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Nieuwbouw & renovatie
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Groepen & bedrading
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Keuringswaardig opgeleverd
      </div>
    </div>

    <section style="background: var(--zwart);">
      <div style="max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;">
        <div>
          <div class="section-eyebrow">Elektra installatie</div>
          <h2 class="section-title">Van a tot z<br>geregeld</h2>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Of u nu een nieuwe woning wilt aansluiten, een verbouwing uitvoert of uw bestaande elektra wilt uitbreiden — Bruggink Totaal Techniek verzorgt de volledige elektra-installatie van a tot z. Wij leggen bedrading aan, plaatsen stopcontacten en schakelaars, installeren verlichting en zorgen voor een correcte aansluiting op de groepenkast.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Naast woningen werken wij ook voor bedrijfspanden, schuren en andere gebouwen. Van enkelvoudige aansluitingen tot complete installaties voor nieuwbouwprojecten. Alles wordt netjes weggewerkt, overzichtelijk gelabeld en keuringswaardig opgeleverd.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;">
            Wij werken met moderne groepenverdelers van Hager en zorgen dat uw installatie ook klaar is voor de toekomst — denk aan een extra groep voor zonnepanelen, een laadpaal of een warmtepomp.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:20px;">
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Complete installatie</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Van bedrading tot aansluiting op het net</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Veilig & gekeurd</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Keuringswaardig en gecertificeerd opgeleverd</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><rect x="2" y="3" width="20" height="18" rx="2"/><line x1="8" y1="3" x2="8" y2="21"/><circle cx="14" cy="9" r="2"/><circle cx="14" cy="15" r="2"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Moderne meterkast</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Hager groepenverdeler, overzichtelijk gelabeld</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Snel & netjes</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Minimale overlast, maximale kwaliteit</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FOTOGALERIJ -->
    <section style="background: var(--grijs);padding-top:80px;padding-bottom:80px;">
      <div style="max-width:1200px;margin:0 auto;">
        <div class="section-eyebrow">Onze projecten</div>
        <h2 class="section-title">Eerder uitgevoerde<br>installaties</h2>
        <div class="zp-galerij">
          <div class="zp-foto zp-foto-groot">
            <img src="/zonnepanelen/zonnepanelen3.jpeg" alt="Elektra installatie nieuwbouw met zonnepanelen" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/meterkast/meterkast2.jpeg" alt="Dubbele Hager groepenverdeler" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--zwart);text-align:center;padding:80px 60px;">
      <div class="section-eyebrow" style="justify-content:center;">Aan de slag</div>
      <h2 class="section-title">Elektra laten aanleggen?</h2>
      <p style="color:#aaa;font-size:18px;max-width:600px;margin:0 auto 40px;line-height:1.7;">
        Vraag vrijblijvend een offerte aan. Wij komen langs voor advies en voeren de werkzaamheden snel en vakkundig uit.
      </p>
      <a href="/#contact" class="btn-primary">Vrijblijvende offerte aanvragen</a>
    </section>

    <Footer />
  </body>
</html>

<style>
  .el-hero {
    position: relative;
    height: 70vh;
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    margin-top: 90px;
  }
  .el-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 40%;
    filter: brightness(0.4);
  }
  .el-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14,14,14,1) 0%, rgba(14,14,14,0.4) 60%, transparent 100%);
  }
  .el-hero-content {
    position: relative;
    z-index: 2;
    padding: 0 60px 70px;
    max-width: 700px;
  }
  .zp-galerij {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .zp-foto-groot { grid-column: span 2; }
  .zp-foto img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }
  .zp-foto-groot img { height: 400px; }
  .zp-foto { overflow: hidden; }
  .zp-foto:hover img { transform: scale(1.04); }
  @media (max-width: 768px) {
    .el-hero-content { padding: 0 24px 50px; }
    .zp-galerij { grid-template-columns: 1fr; }
    .zp-foto-groot { grid-column: span 1; }
    .zp-foto img, .zp-foto-groot img { height: 220px; }
  }
</style>
