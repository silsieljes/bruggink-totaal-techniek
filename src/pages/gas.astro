---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Gasinstallatie door Bruggink Totaal Techniek — aanleg en renovatie van gasleidingen in Drenthe en Overijssel." />
    <title>Gasinstallatie — Bruggink Totaal Techniek</title>
  </head>
  <body>
    <Nav />

    <div class="gas-hero">
      <div class="gas-hero-bg" style="background-image: url('/cv/cv1.jpeg')"></div>
      <div class="gas-hero-overlay"></div>
      <div class="gas-hero-content">
        <div class="hero-eyebrow">Gas</div>
        <h1 class="hero-title">Gas<span>installatie</span></h1>
        <p class="hero-sub">Veilig en gecertificeerd gasleidingwerk voor woning en bedrijf. Bruggink Totaal Techniek legt uw gasinstallatie aan — van hoofdaansluiting tot eindpunt.</p>
        <a href="/#contact" class="btn-primary">Vraag een offerte aan</a>
      </div>
    </div>

    <div class="usp-balk">
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Gecertificeerd installateur
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Nieuwbouw & renovatie
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Veilig & gekeurd
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Druktest & certificaat
      </div>
    </div>

    <section style="background: var(--zwart);">
      <div style="max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;">
        <div>
          <div class="section-eyebrow">Gasinstallatie</div>
          <h2 class="section-title">Veilig gas<br>door uw woning</h2>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Een gasinstallatie vraagt om vakmanschap en certificering. Bruggink Totaal Techniek legt gasleidingen aan voor woningen en bedrijfspanden — van de hoofdkraan tot de aansluiting op uw cv-ketel, fornuis of andere gasapparaten.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Wij werken veilig en volgens de geldende normen. Na installatie voeren wij een druktest uit en leveren wij een keuringscertificaat op. Zo weet u zeker dat uw gasinstallatie veilig en goedgekeurd is.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;">
            Denkt u aan verduurzaming? Wij adviseren u ook over de mogelijkheden om uw gasverbruik te verminderen of geheel van het gas af te gaan — in combinatie met een warmtepomp of hybride systeem.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:20px;">
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Veilige installatie</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Volgens alle geldende normen en regelgeving</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M9 12l2 2 4-4"/><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Druktest & certificaat</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Keuringswaardig opgeleverd met documentatie</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 2C6 10 4 14 4 17a8 8 0 0 0 16 0c0-3-2-7-8-15z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Nieuwbouw & renovatie</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Voor woning, bedrijf en appartementencomplex</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Advies verduurzaming</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Van gas naar warmtepomp of hybride</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--grijs);padding-top:80px;padding-bottom:80px;">
      <div style="max-width:1200px;margin:0 auto;">
        <div class="section-eyebrow">Onze projecten</div>
        <h2 class="section-title">Eerder uitgevoerde<br>installaties</h2>
        <div class="zp-galerij">
          <div class="zp-foto zp-foto-groot">
            <img src="/cv/cv6.jpeg" alt="Gasinstallatie met CV ketel en verdeler" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/cv/cv1.jpeg" alt="Gas en leidingwerk aansluiting" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/cv/cv3.jpeg" alt="Vaillant CV ketel gasaansluiting" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/cv/cv7.jpeg" alt="Gasinstallatie meterkast" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--zwart);text-align:center;padding:80px 60px;">
      <div class="section-eyebrow" style="justify-content:center;">Aan de slag</div>
      <h2 class="section-title">Gasinstallatie laten aanleggen?</h2>
      <p style="color:#aaa;font-size:18px;max-width:600px;margin:0 auto 40px;line-height:1.7;">
        Vraag vrijblijvend een offerte aan. Wij komen langs voor advies en installeren uw gasleiding veilig en vakkundig.
      </p>
      <a href="/#contact" class="btn-primary">Vrijblijvende offerte aanvragen</a>
    </section>

    <Footer />
  </body>
</html>

<style>
  .gas-hero {
    position: relative;
    height: 70vh;
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    margin-top: 90px;
  }
  .gas-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    filter: brightness(0.4);
  }
  .gas-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14,14,14,1) 0%, rgba(14,14,14,0.4) 60%, transparent 100%);
  }
  .gas-hero-content {
    position: relative;
    z-index: 2;
    padding: 0 60px 70px;
    max-width: 700px;
  }
  .zp-galerij {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .zp-foto-groot { grid-column: span 2; }
  .zp-foto img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }
  .zp-foto-groot img { height: 400px; }
  .zp-foto { overflow: hidden; }
  .zp-foto:hover img { transform: scale(1.04); }
  @media (max-width: 768px) {
    .gas-hero-content { padding: 0 24px 50px; }
    .zp-galerij { grid-template-columns: 1fr; }
    .zp-foto-groot { grid-column: span 1; }
    .zp-foto img, .zp-foto-groot img { height: 220px; }
  }
</style>
