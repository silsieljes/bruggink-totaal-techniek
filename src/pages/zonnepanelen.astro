---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Zonnepanelen installatie door Bruggink Totaal Techniek — vakkundige montage op elk type dak in Drenthe en Overijssel." />
    <title>Zonnepanelen — Bruggink Totaal Techniek</title>
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
  </head>
  <body>
    <Nav />

    <!-- HERO -->
    <div class="zp-hero">
      <div class="zp-hero-bg" style="background-image: url('/zonnepanelen/zonnepanelen1.jpeg')"></div>
      <div class="zp-hero-overlay"></div>
      <div class="zp-hero-content">
        <div class="hero-eyebrow">Verduurzamen</div>
        <h1 class="hero-title">Zonne<span>panelen</span></h1>
        <p class="hero-sub">Bespaar op uw energierekening en draag bij aan een duurzamere toekomst. Bruggink Totaal Techniek installeert zonnepanelen op elk type dak — vakkundig, snel en zorgeloos.</p>
        <a href="#contact" class="btn-primary">Vraag een offerte aan</a>
      </div>
    </div>

    <!-- USP BALK -->
    <div class="usp-balk">
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Gecertificeerd installateur
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        10 jaar garantie
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Subsidie advies inbegrepen
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Elk type dak
      </div>
    </div>

    <!-- TEKST SECTIE -->
    <section style="background: var(--zwart);">
      <div style="max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;">
        <div>
          <div class="section-eyebrow">Waarom zonnepanelen?</div>
          <h2 class="section-title">Investeer in de<br>toekomst</h2>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Zonnepanelen blijven een slimme investering — ook nu de salderingsregeling is afgebouwd. De sleutel zit in slim eigenverbruik: stroom die u zelf opwekt en direct verbruikt, levert u nog steeds volledige besparing op. Met een thuisbatterij of slimme apparaten zoals een warmtepomp of laadpaal maximaliseert u uw eigen gebruik.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Bruggink Totaal Techniek installeert zonnepanelen op alle daktypen: schuin dak, plat dak en zelfs op de grond. Wij adviseren u eerlijk over de verwachte opbrengst en terugverdientijd op basis van uw specifieke situatie — zodat u weet waar u aan toe bent.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;">
            Dankzij onze samenwerking met toonaangevende leveranciers leveren wij altijd hoogwaardige panelen met uitstekende opbrengst, ook bij bewolkt weer. Wij verzorgen het volledige traject van advies en aanvraag tot montage en aansluiting op het net.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:20px;">
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Tot 70% besparing</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Op uw jaarlijkse energierekening</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">25 jaar productgarantie</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Op de zonnepanelen zelf</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Subsidie mogelijk</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Wij adviseren u over alle mogelijke regelingen</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Meer woningwaarde</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Gemiddeld 3-5% hogere verkoopwaarde</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FOTOGALERIJ -->
    <section style="background: var(--grijs);padding-top:80px;padding-bottom:80px;">
      <div style="max-width:1200px;margin:0 auto;">
        <div class="section-eyebrow">Onze projecten</div>
        <h2 class="section-title">Eerder uitgevoerde<br>installaties</h2>
        <div class="zp-galerij">
          <div class="zp-foto zp-foto-groot">
            <img src="/zonnepanelen/zonnepanelen4.jpeg" alt="Zonnepanelen installatie op het dak" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/zonnepanelen/zonnepanelen1.jpeg" alt="Zonnepanelen op schuin dak" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/zonnepanelen/zonnepanelen2.jpeg" alt="Zonnepanelen op plat dak" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/zonnepanelen/zonnepanelen3.jpeg" alt="Zonnepanelen installatie bezig" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/zonnepanelen/zonnepanelen5.jpeg" alt="Bruggink bus bij zonnepanelen project" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/zonnepanelen/zonnepanelen6.jpeg" alt="Zonnepanelen op grond opstelling" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section style="background: var(--zwart);text-align:center;padding:80px 60px;">
      <div class="section-eyebrow" style="justify-content:center;">Aan de slag</div>
      <h2 class="section-title">Klaar voor gratis zonne-energie?</h2>
      <p style="color:#aaa;font-size:18px;max-width:600px;margin:0 auto 40px;line-height:1.7;">
        Vraag vrijblijvend een offerte aan. Wij berekenen uw terugverdientijd en adviseren u over de beste oplossing voor uw situatie.
      </p>
      <a href="/#contact" class="btn-primary">Vrijblijvende offerte aanvragen</a>
    </section>

    <Footer />
  </body>
</html>

<style>
  .zp-hero {
    position: relative;
    height: 70vh;
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    margin-top: 90px;
  }

  .zp-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 40%;
    filter: brightness(0.4);
  }

  .zp-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14,14,14,1) 0%, rgba(14,14,14,0.4) 60%, transparent 100%);
  }

  .zp-hero-content {
    position: relative;
    z-index: 2;
    padding: 0 60px 70px;
    max-width: 700px;
  }

  .zp-voordeel {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: rgba(255,255,255,0.04);
    border-left: 3px solid var(--oranje);
    padding: 16px 20px;
    border-radius: 2px;
  }

  .zp-voordeel-icon {
    width: 44px;
    height: 44px;
    background: var(--oranje);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .zp-galerij {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto;
    gap: 12px;
  }

  .zp-foto-groot {
    grid-column: span 2;
  }

  .zp-foto img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }

  .zp-foto-groot img {
    height: 400px;
  }

  .zp-foto {
    overflow: hidden;
  }

  .zp-foto:hover img {
    transform: scale(1.04);
  }

  @media (max-width: 768px) {
    .zp-galerij { grid-template-columns: 1fr; }
    .zp-foto-groot { grid-column: span 1; }
    .zp-foto img, .zp-foto-groot img { height: 220px; }
    .zp-hero-content { padding: 0 24px 50px; }
  }
</style>
