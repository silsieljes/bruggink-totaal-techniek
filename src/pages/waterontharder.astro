---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Waterontharder installatie door Bruggink Totaal Techniek — bescherm uw leidingen en apparaten in Drenthe en Overijssel." />
    <title>Waterontharder — Bruggink Totaal Techniek</title>
  </head>
  <body>
    <Nav />

    <div class="wo-hero">
      <div class="wo-hero-bg" style="background-image: url('/cv/cv2.jpeg')"></div>
      <div class="wo-hero-overlay"></div>
      <div class="wo-hero-content">
        <div class="hero-eyebrow">Sanitair</div>
        <h1 class="hero-title">Water<span>ontharder</span></h1>
        <p class="hero-sub">Hard water beschadigt uw leidingen, boiler en apparaten. Een waterontharder beschermt uw installatie en zorgt voor zacht, aangenaam water door het hele huis.</p>
        <a href="/#contact" class="btn-primary">Vraag een offerte aan</a>
      </div>
    </div>

    <div class="usp-balk">
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Beschermt uw leidingen
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Minder kalk
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Langere levensduur apparaten
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Vakkundige installatie
      </div>
    </div>

    <section style="background: var(--zwart);">
      <div style="max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;">
        <div>
          <div class="section-eyebrow">Waterontharder</div>
          <h2 class="section-title">Zacht water<br>door heel uw huis</h2>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            In grote delen van Drenthe en Overijssel is het leidingwater relatief hard. Hard water bevat veel kalk, wat zich afzet in uw leidingen, boiler, geiser, wasmachine en vaatwasser. Dit leidt tot verhoogd energieverbruik, snellere slijtage en uiteindelijk kostbare reparaties.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Een waterontharder lost dit probleem op door de kalk uit het water te halen voordat het door uw huis stroomt. Het resultaat: geen kalkaanslag meer op kranen en tegels, langere levensduur van uw apparaten en een aangenamer gevoel bij douchen en wassen.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;">
            Bruggink Totaal Techniek installeert waterontharders vakkundig en op de juiste plek in uw waterinstallatie. Wij adviseren u over het juiste type en de capaciteit die past bij uw gezinsgrootte en waterverbruik.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:20px;">
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 2C6 10 4 14 4 17a8 8 0 0 0 16 0c0-3-2-7-8-15z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Geen kalk meer</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Geen aanslag op kranen, douche en tegels</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Beschermt uw installatie</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Leidingen, boiler en apparaten gaan langer mee</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Lager energieverbruik</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Kalkvrije boiler werkt efficiënter</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Snel geïnstalleerd</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Veelal binnen een halve dag geplaatst</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--grijs);padding-top:80px;padding-bottom:80px;">
      <div style="max-width:1200px;margin:0 auto;">
        <div class="section-eyebrow">Onze projecten</div>
        <h2 class="section-title">Eerder uitgevoerde<br>installaties</h2>
        <div class="zp-galerij">
          <div class="zp-foto zp-foto-groot">
            <img src="/waterontharder/waterontharder1.jpeg" alt="Waterontharder installatie in meterkast" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/waterontharder/waterontharder2.jpeg" alt="Waterontharder systeem met zouttabletten" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--zwart);text-align:center;padding:80px 60px;">
      <div class="section-eyebrow" style="justify-content:center;">Aan de slag</div>
      <h2 class="section-title">Waterontharder laten plaatsen?</h2>
      <p style="color:#aaa;font-size:18px;max-width:600px;margin:0 auto 40px;line-height:1.7;">
        Vraag vrijblijvend een offerte aan. Wij adviseren u over het juiste type en installeren de waterontharder vakkundig.
      </p>
      <a href="/#contact" class="btn-primary">Vrijblijvende offerte aanvragen</a>
    </section>

    <Footer />
  </body>
</html>

<style>
  .wo-hero {
    position: relative;
    height: 70vh;
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    margin-top: 90px;
  }
  .wo-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    filter: brightness(0.4);
  }
  .wo-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14,14,14,1) 0%, rgba(14,14,14,0.4) 60%, transparent 100%);
  }
  .wo-hero-content {
    position: relative;
    z-index: 2;
    padding: 0 60px 70px;
    max-width: 700px;
  }
  .zp-galerij {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .zp-foto-groot { grid-column: span 2; }
  .zp-foto img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }
  .zp-foto-groot img { height: 400px; }
  .zp-foto { overflow: hidden; }
  .zp-foto:hover img { transform: scale(1.04); }
  @media (max-width: 768px) {
    .wo-hero-content { padding: 0 24px 50px; }
    .zp-galerij { grid-template-columns: 1fr; }
    .zp-foto-groot { grid-column: span 1; }
    .zp-foto img, .zp-foto-groot img { height: 220px; }
  }
</style>
