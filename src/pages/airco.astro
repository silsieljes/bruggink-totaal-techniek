---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Airco installatie door Bruggink Totaal Techniek — koeling én verwarming in Drenthe en Overijssel." />
    <title>Airco — Bruggink Totaal Techniek</title>
  </head>
  <body>
    <Nav />

    <!-- HERO -->
    <div class="ac-hero">
      <div class="ac-hero-bg" style="background-image: url('/airco/airco1.jpeg')"></div>
      <div class="ac-hero-overlay"></div>
      <div class="ac-hero-content">
        <div class="hero-eyebrow">Verduurzamen</div>
        <h1 class="hero-title">Airco <span>installatie</span></h1>
        <p class="hero-sub">Koel in de zomer, warm in de winter. Bruggink Totaal Techniek installeert uw airco vakkundig en stil — voor thuis én op kantoor.</p>
        <a href="/#contact" class="btn-primary">Vraag een offerte aan</a>
      </div>
    </div>

    <!-- USP BALK -->
    <div class="usp-balk">
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Gecertificeerd installateur
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Koelen én verwarmen
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Thuis & zakelijk
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Merk: LG & meer
      </div>
    </div>

    <!-- TEKST SECTIE -->
    <section style="background: var(--zwart);">
      <div style="max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;">
        <div>
          <div class="section-eyebrow">Waarom een airco?</div>
          <h2 class="section-title">Het hele jaar<br>comfortabel</h2>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Een moderne airco is veel meer dan alleen koeling. In de zomer zorgt hij voor een aangename temperatuur, in de winter kan hij efficiënt bijverwarmen. Zo heeft u het hele jaar door optimaal comfort.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Wij werken met kwalitatieve merken zoals LG — bekend om hun stille werking, hoog rendement en strakke uitstraling. De binnenunit past naadloos in uw interieur, de buitenunit plaatsen wij op een nette, stabiele locatie.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;">
            Bruggink Totaal Techniek verzorgt de volledige installatie van binnenunit, buitenunit en leidingwerk — netjes weggewerkt en gebruiksklaar opgeleverd.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:20px;">
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Koel in de zomer</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Snel en stil uw woning op temperatuur</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 2C6 10 4 14 4 17a8 8 0 0 0 16 0c0-3-2-7-8-15z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Warm in de winter</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Efficiënt bijverwarmen met warmtepompfunctie</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Stille werking</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Nauwelijks hoorbaar, ook 's nachts</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><rect x="2" y="7" width="20" height="14" rx="2"/><line x1="6" y1="7" x2="6" y2="3"/><line x1="10" y1="7" x2="10" y2="3"/><line x1="14" y1="7" x2="14" y2="3"/><line x1="18" y1="7" x2="18" y2="3"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Netjes weggewerkt</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Leidingwerk strak en onzichtbaar verwerkt</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FOTOGALERIJ -->
    <section style="background: var(--grijs);padding-top:80px;padding-bottom:80px;">
      <div style="max-width:1200px;margin:0 auto;">
        <div class="section-eyebrow">Onze projecten</div>
        <h2 class="section-title">Eerder uitgevoerde<br>installaties</h2>
        <div class="zp-galerij">
          <div class="zp-foto zp-foto-groot">
            <img src="/airco/airco1.jpeg" alt="LG airco binnenunit" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/airco/airco2.jpeg" alt="LG airco buitenunit op dak" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section style="background: var(--zwart);text-align:center;padding:80px 60px;">
      <div class="section-eyebrow" style="justify-content:center;">Aan de slag</div>
      <h2 class="section-title">Klaar voor optimaal comfort?</h2>
      <p style="color:#aaa;font-size:18px;max-width:600px;margin:0 auto 40px;line-height:1.7;">
        Vraag vrijblijvend een offerte aan. Wij komen langs voor advies en installeren uw airco snel en vakkundig.
      </p>
      <a href="/#contact" class="btn-primary">Vrijblijvende offerte aanvragen</a>
    </section>

    <Footer />
  </body>
</html>

<style>
  .ac-hero {
    position: relative;
    height: 70vh;
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    margin-top: 90px;
  }
  .ac-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 40%;
    filter: brightness(0.4);
  }
  .ac-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14,14,14,1) 0%, rgba(14,14,14,0.4) 60%, transparent 100%);
  }
  .ac-hero-content {
    position: relative;
    z-index: 2;
    padding: 0 60px 70px;
    max-width: 700px;
  }
  .zp-galerij {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .zp-foto-groot { grid-column: span 2; }
  .zp-foto img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }
  .zp-foto-groot img { height: 400px; }
  .zp-foto { overflow: hidden; }
  .zp-foto:hover img { transform: scale(1.04); }

  @media (max-width: 768px) {
    .ac-hero-content { padding: 0 24px 50px; }
    .zp-galerij { grid-template-columns: 1fr; }
    .zp-foto-groot { grid-column: span 1; }
    .zp-foto img, .zp-foto-groot img { height: 220px; }
  }
</style>
