---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Waterinstallatie door Bruggink Totaal Techniek — aanleg en renovatie van water en leidingwerk in Drenthe en Overijssel." />
    <title>Waterinstallatie — Bruggink Totaal Techniek</title>
  </head>
  <body>
    <Nav />

    <div class="wi-hero">
      <div class="wi-hero-bg" style="background-image: url('/cv/cv2.jpeg')"></div>
      <div class="wi-hero-overlay"></div>
      <div class="wi-hero-content">
        <div class="hero-eyebrow">Water</div>
        <h1 class="hero-title">Water<span>installatie</span></h1>
        <p class="hero-sub">Van koud- en warmwaterleidingen tot complete waterinstallaties — Bruggink Totaal Techniek legt uw leidingwerk vakkundig en duurzaam aan.</p>
        <a href="/#contact" class="btn-primary">Vraag een offerte aan</a>
      </div>
    </div>

    <div class="usp-balk">
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Nieuwbouw & renovatie
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Koper & kunststof leidingen
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Warm & koud water
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Netjes weggewerkt
      </div>
    </div>

    <section style="background: var(--zwart);">
      <div style="max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;">
        <div>
          <div class="section-eyebrow">Waterinstallatie</div>
          <h2 class="section-title">Degelijk leidingwerk<br>van a tot z</h2>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Of u nu een nieuwe woning bouwt, een verbouwing uitvoert of uw bestaande waterinstallatie wilt vernieuwen — Bruggink Totaal Techniek verzorgt de complete aanleg van uw water- en leidingwerk. Van de hoofdaansluiting tot aan de kraan.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Wij werken met kwaliteitsmateriaal zoals koperen leidingen en moderne kunststof systemen. Alle leidingen worden netjes weggewerkt, goed geïsoleerd en keuringswaardig opgeleverd. Druktest en controle zijn standaard onderdeel van onze oplevering.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;">
            Naast woningen verzorgen wij ook waterinstallaties voor bedrijfspanden en appartementengebouwen. Wij regelen de verdeling van warm en koud water, de aansluiting op de boiler en alle aftakkingen naar badkamer, keuken en toiletruimtes.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:20px;">
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 2C6 10 4 14 4 17a8 8 0 0 0 16 0c0-3-2-7-8-15z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Complete aanleg</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Van hoofdaansluiting tot kraan</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Lekdicht opgeleverd</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Inclusief druktest en controle</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Woning & bedrijf</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Van appartement tot bedrijfspand</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Netjes afgewerkt</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Leidingen weggewerkt en goed geïsoleerd</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--grijs);padding-top:80px;padding-bottom:80px;">
      <div style="max-width:1200px;margin:0 auto;">
        <div class="section-eyebrow">Onze projecten</div>
        <h2 class="section-title">Eerder uitgevoerde<br>installaties</h2>
        <div class="zp-galerij">
          <div class="zp-foto zp-foto-groot">
            <img src="/cv/cv4.jpeg" alt="Koper leidingwerk verdeling appartementencomplex" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/cv/cv2.jpeg" alt="Koper leidingwerk waterinstallatie" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/cv/cv5.jpeg" alt="Leidingwerk verdeling meerdere units" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/waterontharder/waterontharder1.jpeg" alt="Waterinstallatie met filter in meterkast" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--zwart);text-align:center;padding:80px 60px;">
      <div class="section-eyebrow" style="justify-content:center;">Aan de slag</div>
      <h2 class="section-title">Waterinstallatie laten aanleggen?</h2>
      <p style="color:#aaa;font-size:18px;max-width:600px;margin:0 auto 40px;line-height:1.7;">
        Vraag vrijblijvend een offerte aan. Wij komen langs voor advies en verzorgen uw waterinstallatie vakkundig en netjes.
      </p>
      <a href="/#contact" class="btn-primary">Vrijblijvende offerte aanvragen</a>
    </section>

    <Footer />
  </body>
</html>

<style>
  .wi-hero {
    position: relative;
    height: 70vh;
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    margin-top: 90px;
  }
  .wi-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    filter: brightness(0.4);
  }
  .wi-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14,14,14,1) 0%, rgba(14,14,14,0.4) 60%, transparent 100%);
  }
  .wi-hero-content {
    position: relative;
    z-index: 2;
    padding: 0 60px 70px;
    max-width: 700px;
  }
  .zp-galerij {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .zp-foto-groot { grid-column: span 2; }
  .zp-foto img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }
  .zp-foto-groot img { height: 400px; }
  .zp-foto { overflow: hidden; }
  .zp-foto:hover img { transform: scale(1.04); }
  @media (max-width: 768px) {
    .wi-hero-content { padding: 0 24px 50px; }
    .zp-galerij { grid-template-columns: 1fr; }
    .zp-foto-groot { grid-column: span 1; }
    .zp-foto img, .zp-foto-groot img { height: 220px; }
  }
</style>
