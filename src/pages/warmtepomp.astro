---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Warmtepomp installatie door Bruggink Totaal Techniek — hybride en volledige warmtepompen in Drenthe en Overijssel." />
    <title>Warmtepomp — Bruggink Totaal Techniek</title>
  </head>
  <body>
    <Nav />

    <!-- HERO -->
    <div class="wp-hero">
      <div class="wp-hero-bg" style="background-image: url('/warmtepomp/warmtepomp1.jpeg')"></div>
      <div class="wp-hero-overlay"></div>
      <div class="wp-hero-content">
        <div class="hero-eyebrow">Verduurzamen</div>
        <h1 class="hero-title">Warmte<span>pomp</span></h1>
        <p class="hero-sub">Duurzaam verwarmen met minder gas — of helemaal gasloos. Bruggink Totaal Techniek installeert hybride en volledig elektrische warmtepompen, vakkundig en op maat.</p>
        <a href="/#contact" class="btn-primary">Vraag een offerte aan</a>
      </div>
    </div>

    <!-- USP BALK -->
    <div class="usp-balk">
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Gecertificeerd installateur
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Hybride & volledig elektrisch
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Subsidie advies inbegrepen
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Merken: Vaillant & Atlantic
      </div>
    </div>

    <!-- TEKST SECTIE -->
    <section style="background: var(--zwart);">
      <div style="max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;">
        <div>
          <div class="section-eyebrow">Waarom een warmtepomp?</div>
          <h2 class="section-title">Minder gas,<br>meer comfort</h2>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Een warmtepomp haalt warmte uit de buitenlucht en zet dit om in verwarmingsenergie voor uw woning. Dit is veel efficiënter dan een traditionele cv-ketel — voor elke kilowatt stroom levert een warmtepomp 3 tot 5 kilowatt aan warmte op.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Twijfelt u of een volledige warmtepomp al haalbaar is voor uw woning? Een hybride warmtepomp combineert het beste van beide werelden: de warmtepomp doet het meeste werk, de bestaande cv-ketel springt bij op koude dagen. Zo bespaart u direct op gasverbruik zonder grote aanpassingen.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;">
            Bruggink Totaal Techniek adviseert u welke oplossing het beste past bij uw woning, isolatiegraad en wensen. Wij verzorgen de volledige installatie inclusief aansluiting, inregeling en aanvraag van eventuele subsidie.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:20px;">
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 2C6 10 4 14 4 17a8 8 0 0 0 16 0c0-3-2-7-8-15z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Tot 60% minder gasverbruik</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Met een hybride warmtepomp</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">ISDE subsidie mogelijk</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Wij regelen de aanvraag voor u</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Snel geïnstalleerd</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Hybride vaak binnen één dag geplaatst</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M14 9V5a3 3 0 0 0-6 0v4"/><rect x="2" y="9" width="20" height="13" rx="2"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Ook in de zomer: koeling</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Veel warmtepompen kunnen ook koelen</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FOTOGALERIJ -->
    <section style="background: var(--grijs);padding-top:80px;padding-bottom:80px;">
      <div style="max-width:1200px;margin:0 auto;">
        <div class="section-eyebrow">Onze projecten</div>
        <h2 class="section-title">Eerder uitgevoerde<br>installaties</h2>
        <div class="zp-galerij">
          <div class="zp-foto zp-foto-groot">
            <img src="/warmtepomp/warmtepomp1.jpeg" alt="Vaillant warmtepomp buiten unit" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/warmtepomp/warmtepomp2.jpeg" alt="Warmtepomp installatie binnen" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/warmtepomp/warmtepomp3.jpeg" alt="CV installatie met warmtepomp" loading="lazy" />
          </div>
          <div class="zp-foto zp-foto-groot">
            <img src="/warmtepomp/warmtepomp4.jpeg" alt="Voor en na warmtepomp installatie" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section style="background: var(--zwart);text-align:center;padding:80px 60px;">
      <div class="section-eyebrow" style="justify-content:center;">Aan de slag</div>
      <h2 class="section-title">Klaar om te verduurzamen?</h2>
      <p style="color:#aaa;font-size:18px;max-width:600px;margin:0 auto 40px;line-height:1.7;">
        Vraag vrijblijvend een offerte aan. Wij komen langs voor een adviesgesprek en berekenen wat een warmtepomp voor uw situatie kan betekenen.
      </p>
      <a href="/#contact" class="btn-primary">Vrijblijvende offerte aanvragen</a>
    </section>

    <Footer />
  </body>
</html>

<style>
  .wp-hero {
    position: relative;
    height: 70vh;
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    margin-top: 90px;
  }

  .wp-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 40%;
    filter: brightness(0.4);
  }

  .wp-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14,14,14,1) 0%, rgba(14,14,14,0.4) 60%, transparent 100%);
  }

  .wp-hero-content {
    position: relative;
    z-index: 2;
    padding: 0 60px 70px;
    max-width: 700px;
  }

  @media (max-width: 768px) {
    .wp-hero-content { padding: 0 24px 50px; }
    #wp-tekst > div { grid-template-columns: 1fr !important; gap: 40px !important; }
    .zp-galerij { grid-template-columns: 1fr; }

    .zp-foto img, .zp-foto-groot img { height: 220px; }
  }
</style>
