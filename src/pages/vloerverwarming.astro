---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Vloerverwarming installatie door Bruggink Totaal Techniek — comfortabele en efficiënte verwarming in Drenthe en Overijssel." />
    <title>Vloerverwarming — Bruggink Totaal Techniek</title>
  </head>
  <body>
    <Nav />

    <!-- HERO -->
    <div class="vv-hero">
      <div class="vv-hero-bg" style="background-image: url('/vloerverwarming/vloerverwarming9.jpeg')"></div>
      <div class="vv-hero-overlay"></div>
      <div class="vv-hero-content">
        <div class="hero-eyebrow">Installatie techniek</div>
        <h1 class="hero-title">Vloer<span>verwarming</span></h1>
        <p class="hero-sub">Warm comfort van onder de vloer — gelijkmatig, efficiënt en onzichtbaar. Bruggink Totaal Techniek installeert vloerverwarming in nieuwbouw én bestaande woningen.</p>
        <a href="/#contact" class="btn-primary">Vraag een offerte aan</a>
      </div>
    </div>

    <!-- USP BALK -->
    <div class="usp-balk">
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Nieuwbouw & renovatie
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Geschikt voor warmtepomp
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Zoneregelingen mogelijk
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Vakkundige installatie
      </div>
    </div>

    <!-- TEKST SECTIE -->
    <section style="background: var(--zwart);">
      <div style="max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;">
        <div>
          <div class="section-eyebrow">Waarom vloerverwarming?</div>
          <h2 class="section-title">Comfort van<br>onder af</h2>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Vloerverwarming verwarmt uw woning op de meest aangename manier — gelijkmatig, van onder de vloer omhoog. Geen koude voeten, geen zichtbare radiatoren en geen droge lucht. Gewoon aangenaam warm comfort in elke ruimte.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Vloerverwarming werkt op lage temperaturen — ideaal in combinatie met een warmtepomp. Dit maakt het systeem zeer energiezuinig en toekomstbestendig. Bruggink Totaal Techniek installeert vloerverwarming in zowel nieuwbouwwoningen als bij renovaties.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;">
            Wij verzorgen het complete traject: van ontwerp en aanleg van de leidingen tot aansluiting op de verdeler en het inregelen van de zoneregelingen. Netjes, vakkundig en volgens de regels van de kunst.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:20px;">
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 2C6 10 4 14 4 17a8 8 0 0 0 16 0c0-3-2-7-8-15z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Gelijkmatige warmte</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Geen koude hoeken, overal aangenaam warm</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Energiezuinig</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Werkt op lage temperatuur — ideaal met warmtepomp</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Zoneregelingen</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Elke ruimte op eigen temperatuur instelbaar</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Onzichtbaar systeem</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Geen radiatoren, meer ruimte en vrijheid</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FOTOGALERIJ -->
    <section style="background: var(--grijs);padding-top:80px;padding-bottom:80px;">
      <div style="max-width:1200px;margin:0 auto;">
        <div class="section-eyebrow">Onze projecten</div>
        <h2 class="section-title">Eerder uitgevoerde<br>installaties</h2>
        <div class="zp-galerij">
          <div class="zp-foto zp-foto-groot">
            <img src="/vloerverwarming/vloerverwarming9.jpeg" alt="Team aan het werk met vloerverwarming" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/vloerverwarming/vloerverwarming1.jpeg" alt="Verdeler vloerverwarming" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/vloerverwarming/vloerverwarming2.jpeg" alt="Vloerverwarming leidingen aanleg" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/vloerverwarming/vloerverwarming3.jpeg" alt="Vloerverwarming badkamer" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/vloerverwarming/vloerverwarming4.jpeg" alt="Druktest vloerverwarming" loading="lazy" />
          </div>
          <div class="zp-foto zp-foto-groot">
            <img src="/vloerverwarming/vloerverwarming5.jpeg" alt="Grote verdeler installatie" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/vloerverwarming/vloerverwarming6.jpeg" alt="Vloerverwarming woonkamer" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/vloerverwarming/vloerverwarming7.jpeg" alt="Vloerverwarming leidingen patroon" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/vloerverwarming/vloerverwarming8.jpeg" alt="Verdeler systeem vloerverwarming" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section style="background: var(--zwart);text-align:center;padding:80px 60px;">
      <div class="section-eyebrow" style="justify-content:center;">Aan de slag</div>
      <h2 class="section-title">Warm comfort in uw woning?</h2>
      <p style="color:#aaa;font-size:18px;max-width:600px;margin:0 auto 40px;line-height:1.7;">
        Vraag vrijblijvend een offerte aan. Wij adviseren u over de mogelijkheden en installeren uw vloerverwarming vakkundig.
      </p>
      <a href="/#contact" class="btn-primary">Vrijblijvende offerte aanvragen</a>
    </section>

    <Footer />
  </body>
</html>

<style>
  .vv-hero {
    position: relative;
    height: 70vh;
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    margin-top: 90px;
  }
  .vv-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 40%;
    filter: brightness(0.4);
  }
  .vv-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14,14,14,1) 0%, rgba(14,14,14,0.4) 60%, transparent 100%);
  }
  .vv-hero-content {
    position: relative;
    z-index: 2;
    padding: 0 60px 70px;
    max-width: 700px;
  }
  .zp-galerij {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .zp-foto-groot { grid-column: span 2; }
  .zp-foto img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }
  .zp-foto-groot img { height: 400px; }
  .zp-foto { overflow: hidden; }
  .zp-foto:hover img { transform: scale(1.04); }

  @media (max-width: 768px) {
    .vv-hero-content { padding: 0 24px 50px; }
    .zp-galerij { grid-template-columns: 1fr; }
    .zp-foto-groot { grid-column: span 1; }
    .zp-foto img, .zp-foto-groot img { height: 220px; }
  }
</style>
