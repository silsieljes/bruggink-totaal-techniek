---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Subsidie en leningen voor verduurzaming in Hardenberg en omgeving. Informatie over ISDE, gemeentelijke subsidies en het Warmtefonds in Overijssel." />
    <title>Subsidie & Verduurzaming Hardenberg | Bruggink Totaal Techniek</title>
  </head>
  <body>
    <Nav />

    <!-- HERO -->
    <div style="position:relative;height:40vh;min-height:300px;display:flex;align-items:flex-end;overflow:hidden;margin-top:90px;background:#0e0e0e;">
      <div style="position:absolute;inset:0;background:linear-gradient(135deg,#1a1a1a 0%,#0e0e0e 100%);"></div>
      <div style="position:absolute;left:0;top:0;bottom:0;width:5px;background:#E85500;"></div>
      <div style="position:relative;z-index:2;padding:0 60px 60px;max-width:800px;">
        <div class="hero-eyebrow">Verduurzamen</div>
        <h1 class="hero-title">Subsidie & <span>financiering</span></h1>
        <p class="hero-sub">Verduurzamen loont — en er is meer financiële hulp beschikbaar dan u denkt. Wij helpen u wegwijs in de mogelijkheden.</p>
      </div>
    </div>

    <!-- USP BALK -->
    <div class="usp-balk">
      <div class="usp-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>ISDE subsidie</div>
      <div class="usp-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>Gemeentelijke regelingen</div>
      <div class="usp-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>Warmtefonds lening</div>
      <div class="usp-item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>Gratis advies</div>
    </div>

    <!-- CONTENT -->
    <section style="background: var(--zwart);">
      <div style="max-width:1100px;margin:0 auto;">

        <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:48px;max-width:800px;">
          Er zijn diverse regelingen beschikbaar die verduurzaming financieel aantrekkelijk maken. Hieronder vindt u een overzicht van de belangrijkste opties. Bruggink Totaal Techniek adviseert u graag over welke regelingen van toepassing zijn op uw situatie.
        </p>

        <!-- ISDE -->
        <div class="sub-card">
          <div class="sub-card-header">
            <div class="sub-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="28" height="28"><path d="M12 2C6 10 4 14 4 17a8 8 0 0 0 16 0c0-3-2-7-8-15z"/></svg>
            </div>
            <div>
              <h2 class="sub-titel">ISDE — Investeringssubsidie Duurzame Energie</h2>
              <span class="sub-label">Rijksoverheid</span>
            </div>
          </div>
          <p style="color:#aaa;font-size:16px;line-height:1.8;margin-bottom:16px;">
            De ISDE is een subsidie van de rijksoverheid voor de aanschaf van een warmtepomp of zonneboiler. De subsidie wordt aangevraagd via de RVO (Rijksdienst voor Ondernemend Nederland) en kan oplopen tot enkele duizenden euro's afhankelijk van het type installatie.
          </p>
          <ul class="sub-lijst">
            <li>Voor particulieren én bedrijven</li>
            <li>Geldt voor warmtepompen en zonneboilers</li>
            <li>Aanvragen via rvo.nl</li>
            <li>Wij verzorgen de benodigde documenten</li>
          </ul>
        </div>

        <!-- Gemeente -->
        <div class="sub-card">
          <div class="sub-card-header">
            <div class="sub-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="28" height="28"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <div>
              <h2 class="sub-titel">Gemeentelijke subsidies</h2>
              <span class="sub-label">Gemeente Hardenberg & omgeving</span>
            </div>
          </div>
          <p style="color:#aaa;font-size:16px;line-height:1.8;margin-bottom:16px;">
            Veel gemeenten in Overijssel bieden aanvullende subsidies of leningen aan voor woningeigenaren die willen verduurzamen. De gemeente Hardenberg heeft regelmatig regelingen beschikbaar voor isolatie, zonnepanelen en warmtepompen.
          </p>
          <ul class="sub-lijst">
            <li>Controleer het actuele aanbod op de website van uw gemeente</li>
            <li>Vaak combineerbaar met de ISDE subsidie</li>
            <li>Soms ook voor huurders beschikbaar</li>
            <li>Wij adviseren u over de mogelijkheden in uw gemeente</li>
          </ul>
        </div>

        <!-- Warmtefonds -->
        <div class="sub-card">
          <div class="sub-card-header">
            <div class="sub-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="28" height="28"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/></svg>
            </div>
            <div>
              <h2 class="sub-titel">Warmtefonds — Verduurzaam lening</h2>
              <span class="sub-label">Laagrentende lening</span>
            </div>
          </div>
          <p style="color:#aaa;font-size:16px;line-height:1.8;margin-bottom:16px;">
            Het Warmtefonds biedt laagrentende leningen aan voor woningeigenaren die willen verduurzamen maar de investering niet in één keer kunnen betalen. De lening wordt terugbetaald via de energiebesparing die de maatregelen opleveren.
          </p>
          <ul class="sub-lijst">
            <li>Leningen vanaf €2.500 tot €75.000</li>
            <li>Lage rente — soms zelfs 0% voor lagere inkomens</li>
            <li>Voor warmtepomp, isolatie, zonnepanelen en meer</li>
            <li>Aanvragen via warmtefonds.nl</li>
          </ul>
        </div>

        <!-- SEPP -->
        <div class="sub-card">
          <div class="sub-card-header">
            <div class="sub-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="28" height="28"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <div>
              <h2 class="sub-titel">SEPP — Subsidie elektrische personenauto</h2>
              <span class="sub-label">Laadpaal subsidie</span>
            </div>
          </div>
          <p style="color:#aaa;font-size:16px;line-height:1.8;margin-bottom:16px;">
            Heeft u een elektrische auto of bent u van plan er een te kopen? Dan kunt u mogelijk SEPP subsidie aanvragen voor de aanschaf van een laadpaal. Informeer bij uw gemeente of de RVO naar de actuele voorwaarden.
          </p>
          <ul class="sub-lijst">
            <li>Subsidie voor thuislaadpaal bij elektrische auto</li>
            <li>Controleer de actuele voorwaarden via rvo.nl</li>
            <li>Wij installeren uw laadpaal vakkundig en veilig</li>
          </ul>
        </div>

      </div>
    </section>

    <!-- CTA -->
    <section style="background: var(--grijs);text-align:center;padding:80px 60px;">
      <div class="section-eyebrow" style="justify-content:center;">Gratis advies</div>
      <h2 class="section-title">Welke subsidie past bij u?</h2>
      <p style="color:#aaa;font-size:18px;max-width:600px;margin:0 auto 40px;line-height:1.7;">
        Wij helpen u graag met het uitzoeken welke regelingen van toepassing zijn op uw situatie. Neem contact op voor een vrijblijvend adviesgesprek.
      </p>
      <a href="/#contact" class="btn-primary">Vraag gratis advies aan</a>
    </section>

    <Footer />
  </body>
</html>

<style>
  .sub-card {
    background: var(--grijs);
    border-radius: 4px;
    padding: 36px 40px;
    margin-bottom: 24px;
    border-left: 4px solid var(--oranje);
  }

  .sub-card-header {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 20px;
  }

  .sub-icon {
    width: 56px;
    height: 56px;
    background: var(--oranje);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sub-titel {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 24px;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--wit);
    letter-spacing: 0.04em;
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .sub-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--oranje);
  }

  .sub-lijst {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sub-lijst li {
    color: #aaa;
    font-size: 15px;
    padding-left: 20px;
    position: relative;
  }

  .sub-lijst li::before {
    content: '▸';
    color: var(--oranje);
    position: absolute;
    left: 0;
  }

  @media (max-width: 768px) {
    .sub-card { padding: 24px 20px; }
    .sub-titel { font-size: 20px; }
  }
</style>
