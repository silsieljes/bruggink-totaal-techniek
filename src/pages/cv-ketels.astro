---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="CV ketel installatie en onderhoud door Bruggink Totaal Techniek — betrouwbare verwarming in Drenthe en Overijssel." />
    <title>CV Ketels — Bruggink Totaal Techniek</title>
  </head>
  <body>
    <Nav />

    <!-- HERO -->
    <div class="cv-hero">
      <div class="cv-hero-bg" style="background-image: url('/cv/cv6.jpeg')"></div>
      <div class="cv-hero-overlay"></div>
      <div class="cv-hero-content">
        <div class="hero-eyebrow">Installatie techniek</div>
        <h1 class="hero-title">CV <span>Ketels</span></h1>
        <p class="hero-sub">Betrouwbare verwarming voor uw woning of bedrijfspand. Bruggink Totaal Techniek installeert, vervangt en onderhoudt cv-ketels van alle merken — vakkundig en netjes afgewerkt.</p>
        <a href="/#contact" class="btn-primary">Vraag een offerte aan</a>
      </div>
    </div>

    <!-- USP BALK -->
    <div class="usp-balk">
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Alle merken
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Installatie & vervanging
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Onderhoud & storing
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Netjes weggewerkt
      </div>
    </div>

    <!-- TEKST SECTIE -->
    <section style="background: var(--zwart);">
      <div style="max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;">
        <div>
          <div class="section-eyebrow">CV ketel installatie</div>
          <h2 class="section-title">Warm en<br>betrouwbaar</h2>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Een goed werkende cv-ketel is de basis van een comfortabel huis. Of u nu toe bent aan vervanging van een oude ketel, een nieuw systeem wilt laten installeren of gewoon periodiek onderhoud nodig heeft — Bruggink Totaal Techniek regelt het voor u.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Wij werken met kwalitatieve merken zoals Vaillant en zorgen voor een nette, vakkundige installatie inclusief het leidingwerk. Alles wordt strak weggewerkt en volledig ingeregeld opgeleverd.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;">
            Denkt u aan verduurzaming? Wij adviseren u ook over de overstap naar een hybride warmtepomp in combinatie met uw bestaande cv-installatie — zo bereikt u maximale besparing met minimale aanpassingen.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:20px;">
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 2C6 10 4 14 4 17a8 8 0 0 0 16 0c0-3-2-7-8-15z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Snelle installatie</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Vervanging vaak binnen één dag gereed</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Garantie op werk</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Wij staan achter onze installaties</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Periodiek onderhoud</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Voorkom storingen met jaarlijks service</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Stap naar hybride</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Advies over combinatie met warmtepomp</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FOTOGALERIJ -->
    <section style="background: var(--grijs);padding-top:80px;padding-bottom:80px;">
      <div style="max-width:1200px;margin:0 auto;">
        <div class="section-eyebrow">Onze projecten</div>
        <h2 class="section-title">Eerder uitgevoerde<br>installaties</h2>
        <div class="zp-galerij">
          <div class="zp-foto zp-foto-groot">
            <img src="/cv/cv6.jpeg" alt="Vaillant CV installatie met vloerverwarming verdeler" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/cv/cv1.jpeg" alt="CV ketel installatie met leidingwerk" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/cv/cv2.jpeg" alt="Leidingwerk CV installatie" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/cv/cv3.jpeg" alt="Vaillant ecoTEC CV ketel" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/cv/cv4.jpeg" alt="Koper leidingwerk installatie" loading="lazy" />
          </div>
          <div class="zp-foto zp-foto-groot">
            <img src="/cv/cv5.jpeg" alt="Leidingwerk appartementencomplex" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/cv/cv7.jpeg" alt="CV ketel meterkast installatie" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section style="background: var(--zwart);text-align:center;padding:80px 60px;">
      <div class="section-eyebrow" style="justify-content:center;">Aan de slag</div>
      <h2 class="section-title">Nieuwe ketel of onderhoud?</h2>
      <p style="color:#aaa;font-size:18px;max-width:600px;margin:0 auto 40px;line-height:1.7;">
        Vraag vrijblijvend een offerte aan. Wij komen langs voor advies en zorgen voor een snelle, nette installatie.
      </p>
      <a href="/#contact" class="btn-primary">Vrijblijvende offerte aanvragen</a>
    </section>

    <Footer />
  </body>
</html>

<style>
  .cv-hero {
    position: relative;
    height: 70vh;
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    margin-top: 90px;
  }
  .cv-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 40%;
    filter: brightness(0.4);
  }
  .cv-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14,14,14,1) 0%, rgba(14,14,14,0.4) 60%, transparent 100%);
  }
  .cv-hero-content {
    position: relative;
    z-index: 2;
    padding: 0 60px 70px;
    max-width: 700px;
  }
  .zp-galerij {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .zp-foto-groot { grid-column: span 2; }
  .zp-foto img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }
  .zp-foto-groot img { height: 400px; }
  .zp-foto { overflow: hidden; }
  .zp-foto:hover img { transform: scale(1.04); }

  @media (max-width: 768px) {
    .cv-hero-content { padding: 0 24px 50px; }
    .zp-galerij { grid-template-columns: 1fr; }
    .zp-foto-groot { grid-column: span 1; }
    .zp-foto img, .zp-foto-groot img { height: 220px; }
  }
</style>
