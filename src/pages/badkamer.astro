---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Badkamer en sanitair installatie door Bruggink Totaal Techniek — complete renovatie en nieuwbouw in Drenthe en Overijssel." />
    <title>Badkamer & Sanitair — Bruggink Totaal Techniek</title>
  </head>
  <body>
    <Nav />

    <div class="bk-hero">
      <div class="bk-hero-bg" style="background-image: url('/badkamer/badkamer2.jpeg')"></div>
      <div class="bk-hero-overlay"></div>
      <div class="bk-hero-content">
        <div class="hero-eyebrow">Sanitair</div>
        <h1 class="hero-title">Badkamer &<br><span>Sanitair</span></h1>
        <p class="hero-sub">Van een complete badkamerrenovatie tot een stijlvolle toiletruimte — Bruggink Totaal Techniek verzorgt alle sanitaire installatiewerken vakkundig en op maat.</p>
        <a href="/#contact" class="btn-primary">Vraag een offerte aan</a>
      </div>
    </div>

    <div class="usp-balk">
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Complete renovatie
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Badkamer & toilet
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Nieuwbouw & verbouw
      </div>
      <div class="usp-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Netjes afgewerkt
      </div>
    </div>

    <section style="background: var(--zwart);">
      <div style="max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;">
        <div>
          <div class="section-eyebrow">Badkamer & sanitair</div>
          <h2 class="section-title">Uw droomkamer<br>gerealiseerd</h2>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Een nieuwe badkamer of toiletruimte is een investering die u elke dag terugziet. Bruggink Totaal Techniek verzorgt de complete sanitaire installatie — van het aanleggen van water- en afvoerleidingen tot het aansluiten van douche, bad, wastafel en toilet.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;margin-bottom:20px;">
            Wij werken nauw samen met u om uw wensen te realiseren. Of u nu kiest voor een strakke inloopdouche met regendouche, een vrijstaand bad of een minimalistische toiletruimte — wij zorgen dat alle aansluitingen perfect zitten en alles waterdicht wordt opgeleverd.
          </p>
          <p style="color:#aaa;font-size:17px;line-height:1.8;">
            Van de ruwbouw tot de afwerking — Bruggink Totaal Techniek ontzorgt u volledig. Wij coördineren het leidingwerk, de aansluitingen en werken nauw samen met tegelzetters en andere vaklieden voor een perfect eindresultaat.
          </p>
        </div>
        <div style="display:flex;flex-direction:column;gap:20px;">
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M4 12h16M4 12a4 4 0 0 1 4-4h8M4 12v5a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/><path d="M12 8V4M10 4h4"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Complete installatie</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Water, afvoer en alle sanitaire aansluitingen</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Waterdicht opgeleverd</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Vakkundige aansluiting, geen lekkages</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><rect x="8" y="3" width="8" height="18" rx="2"/><path d="M4 7h4M12 7h4M4 12h4M12 12h4M4 17h4M12 17h4"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Op maat</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Inloopdouche, bad, wastafel of toilet — wij regelen het</p>
            </div>
          </div>
          <div class="zp-voordeel">
            <div class="zp-voordeel-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" width="24" height="24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <strong style="color:var(--wit);font-family:'Barlow Condensed',sans-serif;font-size:18px;text-transform:uppercase;">Volledige ontzorging</strong>
              <p style="color:#aaa;font-size:14px;margin-top:4px;">Van ruwbouw tot afwerking, wij coördineren alles</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--grijs);padding-top:80px;padding-bottom:80px;">
      <div style="max-width:1200px;margin:0 auto;">
        <div class="section-eyebrow">Onze projecten</div>
        <h2 class="section-title">Eerder uitgevoerde<br>installaties</h2>
        <div class="zp-galerij">
          <div class="zp-foto zp-foto-groot">
            <img src="/badkamer/badkamer2.jpeg" alt="Complete badkamer renovatie met dubbele wastafel en bad" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/badkamer/badkamer1.jpeg" alt="Luxe inloopdouche met regendouche" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/badkamer/badkamer3.jpeg" alt="Dubbele wastafel met verlichte spiegel" loading="lazy" />
          </div>
          <div class="zp-foto">
            <img src="/badkamer/sanitair1.jpeg" alt="Stijlvolle toiletruimte met wandtoilet" loading="lazy" />
          </div>

        </div>
      </div>
    </section>

    <section style="background: var(--zwart);text-align:center;padding:80px 60px;">
      <div class="section-eyebrow" style="justify-content:center;">Aan de slag</div>
      <h2 class="section-title">Badkamer laten renoveren?</h2>
      <p style="color:#aaa;font-size:18px;max-width:600px;margin:0 auto 40px;line-height:1.7;">
        Vraag vrijblijvend een offerte aan. Wij komen langs voor advies en realiseren uw nieuwe badkamer of sanitaire ruimte vakkundig en op maat.
      </p>
      <a href="/#contact" class="btn-primary">Vrijblijvende offerte aanvragen</a>
    </section>

    <Footer />
  </body>
</html>

<style>
  .bk-hero {
    position: relative;
    height: 70vh;
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    margin-top: 90px;
  }
  .bk-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    filter: brightness(0.4);
  }
  .bk-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(14,14,14,1) 0%, rgba(14,14,14,0.4) 60%, transparent 100%);
  }
  .bk-hero-content {
    position: relative;
    z-index: 2;
    padding: 0 60px 70px;
    max-width: 700px;
  }
  .zp-galerij {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .zp-foto-groot { grid-column: span 2; }
  .zp-foto img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }
  .zp-foto-groot img { height: 400px; }
  .zp-foto { overflow: hidden; }
  .zp-foto:hover img { transform: scale(1.04); }
  @media (max-width: 768px) {
    .bk-hero-content { padding: 0 24px 50px; }
    .zp-galerij { grid-template-columns: 1fr; }
    .zp-foto-groot { grid-column: span 1; }
    .zp-foto img, .zp-foto-groot img { height: 220px; }
  }
</style>
